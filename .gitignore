# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment / Secrets ───────────────────────────────────────────────────
# Never commit real credentials. Commit .env.example instead.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Build output ────────────────────────────────────────────────────────────
build/
dist/
.next/
out/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# ─── Runtime / Cache ─────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ─── Test coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── User-uploaded files ─────────────────────────────────────────────────────
# Ignore all uploaded content but keep the folder structure via .gitkeep files
backend/uploads/certificates/*
backend/uploads/medical-records/*
backend/uploads/profile-pictures/*
!backend/uploads/certificates/.gitkeep
!backend/uploads/medical-records/.gitkeep
!backend/uploads/profile-pictures/.gitkeep

# ─── Python (ml-module) ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg-info/
dist/
.venv/
venv/
env/
.env/
