# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/smarthealthcare

# JWT Secret (Change this in production!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration
# For development: Leave EMAIL_HOST empty to use Ethereal (test email)
# For production: Configure with your SMTP provider (Gmail, SendGrid, AWS SES, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Healthcare Appointment <noreply@healthcare.com>"

# Example Gmail configuration:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password

# Example SendGrid configuration:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key

# Scheduled Jobs Configuration
# Set to true to run jobs immediately on startup for testing
RUN_JOBS_ON_STARTUP=false
# Timezone for scheduled jobs (default: America/New_York)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
JOBS_TIMEZONE=America/New_York
